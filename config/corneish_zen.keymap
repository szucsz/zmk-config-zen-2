#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define HS(k)  &hm LSHIFT k
#define HC(k)  &hm LCTRL k
#define HA(k)  &hm LALT k
#define HG(k)  &hm LGUI k
#define GC(k)  &kp LG(LC(k))
#define GA(k)  &kp LG(LA(k))
#define MSC_UP    &msc SCRL_UP
#define MSC_DOWN  &msc SCRL_DOWN
#define MSC_LEFT  &msc SCRL_LEFT
#define MSC_RIGHT &msc SCRL_RIGHT
#define MMV_UP    &mmv MOVE_UP
#define MMV_DOWN  &mmv MOVE_DOWN
#define MMV_LEFT  &mmv MOVE_LEFT
#define MMV_RIGHT &mmv MOVE_RIGHT


&caps_word {
	continue-list = <UNDERSCORE BACKSPACE DELETE>;
};

/ {
    behaviors {
            hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    layer_lower: tap_dance_lower {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_LOWER";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&mo 1>, <&tog 1>;
        };
    layer_raise: tap_dance_raise {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_RAISE";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&mo 2>, <&tog 2>;
        };
    space_ret: tap_dance_space_ret {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SPACE_RET";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp SPACE>, <&kp RET>;
        };
  };

  macros {
    bt_0: bt_profile_macro_0 {
      label = "BT_0";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
        = <&out OUT_BLE>,
          <&bt BT_SEL 0>;
    };
    bt_1: bt_profile_macro_1 {
      label = "BT_1";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
        = <&out OUT_BLE>,
          <&bt BT_SEL 1>;
    };
    bt_2: bt_profile_macro_2 {
      label = "BT_2";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
        = <&out OUT_BLE>,
          <&bt BT_SEL 2>;
    };
    bt_3: bt_profile_macro_3 {
      label = "BT_3";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
        = <&out OUT_BLE>,
          <&bt BT_SEL 3>;
    };
  };

  chosen {
    zmk,physical-layout = &foostan_corne_6col_layout;
  };

  // conditional_layers {
  //   compatible = "zmk,conditional-layers";
  //   tri_layer {
  //     if-layers = <1 2>;
  //     then-layer = <3>;
  //   };
  // };
  combos {
    compatible = "zmk,combos";
    combo_ret_l_VB {
      timeout-ms = <50>;
      key-positions = <28 29>;
      bindings = <&kp RET>;
      layers = <0 1 2>;
    };
    combo_space_l_RT {
      timeout-ms = <50>;
      key-positions = <4 5>;
      bindings = <&kp SPACE>;
      layers = <0 1 2>;
    };
    combo_ret_r_COMMA_DOT {
      timeout-ms = <50>;
      key-positions = <32 33>;
      bindings = <&kp RET>;
      layers = <0 1 2>;
    };
    combo_fun_lock {
      timeout-ms = <50>;
      key-positions = <37 38>;
      bindings = <&tog 1>;
      layers = <0 1>;
    };
    combo_sym_lock {
      timeout-ms = <50>;
      key-positions = <39 40>;
      bindings = <&tog 2>;
      layers = <0 2>;
    };
    combo_meta_lock {
      timeout-ms = <50>;
      key-positions = <37 40>;
      bindings = <&mo 3>;
      layers = <0 3>;
    };
  };
};

/ {
  keymap {
    compatible = "zmk,keymap";
    default_layer {
      display-name = "QWERTY";
      bindings = <
&kp ESC       &kp Q      &kp W        &kp E       &kp R         &kp T         &kp Y       &kp U      &kp I     &kp O     &kp P     &kp GRAVE
&kp LCTRL     &kp A      &kp S        HC(D)       HS(F)         &kp G         &kp H       HS(J)      HC(K)     &kp L     &kp SEMI  &kp SQT
&kp LSHFT     &kp Z      &kp X        &kp C       &kp V         &kp B         &kp N       &kp M      &kp COMMA &kp DOT   &kp FSLH  &kp BSLH
                                             &kp LALT &kp TAB  &lt 1 BSPC   &lt 2 SPACE &kp DEL &kp LGUI
      >;
    };
    lower_layer {
      display-name = "FUN";
      bindings = <
&trans        &kp LC(GRAVE) &kp HOME  &kp UP      &kp END       &kp DEL       &kp F1      &kp F2        &kp F3        &kp F4        &kp F5     &kp F6
&kp LG(TAB)   &kp LA(TAB) &kp LEFT    &kp DOWN    &kp RIGHT     &kp PG_UP     &kp F7      HS(F8)        HC(F9)        HA(F10)       HG(F11)    &kp F12
&caps_word    &kp LC(Z)   &kp LS(DEL) &kp LC(INS) &kp LS(INS)   &kp PG_DN     &kp INS     &kp LC(W)     &kp LC(PG_UP) &kp LC(PG_DN) &kp LC(F5) &kp LC(F12)
                                        &kp C_VOL_DN &kp C_VOL_UP &kp BSPC  &kp SPACE &trans &trans
      >;
    };
    raise_layer {
      display-name = "SYM";
      bindings = <
&trans        &kp EXCL   &kp AT       &kp HASH    &kp DLLR      &kp PRCNT     &kp CARET   &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &kp UNDER
&kp LCTRL     HG(N1)     &kp N2       HC(N3)      &kp N4        &kp N5        &kp N6      &kp N7     HC(N8)    &kp N9    HG(N0)    &kp MINUS
&kp LSHFT     &none      &kp LBKT     &kp RBKT    &kp LBRC      &kp RBRC      &kp UNDER   &kp MINUS  &kp EQUAL &kp PLUS  &kp DOT   &none
                                                   &trans &trans &kp BSPC   &kp SPACE &trans &trans
      >;
    };
    meta_layer {
      display-name = "META";
      bindings = <
&kp ESC      &none       GA(LEFT)     GA(LEFT)    GA(RIGHT)     GC(F4)        &none       &mkp LCLK  &mkp RCLK &none     &none     &studio_unlock
&none        &kp LG(TAB) &kp RET      GC(LEFT)    GC(RIGHT)     GC(D)         &none       MMV_LEFT   MMV_UP    MMV_DOWN  MMV_RIGHT &none
&out OUT_USB &bt_0       &bt_1        &bt_2       &bt_3         &bt BT_CLR    &none       MSC_LEFT   MSC_UP    MSC_DOWN  MSC_RIGHT &none
                                                  &bootloader &none &none   &none &none &bootloader
      >;
    };
  };
};
